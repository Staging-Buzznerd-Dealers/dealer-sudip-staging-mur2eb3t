{
  "id": "request-a-quote",
  "name": "Request a quote",
  "status": "live",
  "system": true,
  "pdpContext": true,
  "surfaces": ["pdp", "partsPdp", "page", "brand"],
  "intent": "get-quote",
  "submitLabel": "Request a quote",
  "successMessage": "Thanks — your quote request is with the sales team.",
  "consent": {
    "enabled": true,
    "required": true,
    "text": "I agree to be contacted about this quote by phone, text or email."
  },
  "fields": [
    { "id": "rq-name", "type": "full_name", "label": "Full name", "required": true },
    { "id": "rq-company", "type": "single_line", "label": "Company", "required": false },
    { "id": "rq-email", "type": "email", "label": "Email", "required": true },
    { "id": "rq-phone", "type": "phone", "label": "Phone", "required": true },
    { "id": "rq-qty", "type": "number", "label": "How many units?", "required": false },
    {
      "id": "rq-trade",
      "type": "radio",
      "label": "Do you have a trade-in?",
      "required": false,
      "options": [
        { "value": "yes", "label": "Yes" },
        { "value": "no", "label": "No" }
      ]
    },
    {
      "id": "rq-trade-detail",
      "type": "paragraph",
      "label": "Tell us about the trade-in",
      "required": false,
      "logic": {
        "logic": "AND",
        "action": "show",
        "rules": [{ "fieldId": "rq-trade", "operator": "is", "value": "yes" }]
      }
    },
    { "id": "rq-message", "type": "paragraph", "label": "Anything else?", "required": false }
  ],
  "notifications": [
    {
      "id": "rq-default",
      "name": "Default",
      "logic": "AND",
      "rules": [],
      "targetType": "role",
      "roleId": "sales-manager",
      "scopeMode": "dynamic"
    }
  ]
}
