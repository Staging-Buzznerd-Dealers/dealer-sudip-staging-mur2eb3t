{
  "id": "schedule-visit",
  "name": "Schedule a visit",
  "status": "live",
  "system": true,
  "pdpContext": true,
  "surfaces": ["pdp", "page"],
  "intent": "schedule-visit",
  "submitLabel": "Request this time",
  "successMessage": "Thanks — the branch will confirm the time with you shortly.",
  "consent": {
    "enabled": true,
    "required": true,
    "text": "I agree to be contacted about this visit by phone, text or email."
  },
  "fields": [
    { "id": "sv-name", "type": "full_name", "label": "Full name", "required": true },
    { "id": "sv-email", "type": "email", "label": "Email", "required": true, "width": "half" },
    { "id": "sv-phone", "type": "phone", "label": "Phone", "required": true, "width": "half" },
    { "id": "sv-date", "type": "date", "label": "Preferred date", "required": true, "width": "half" },
    {
      "id": "sv-time",
      "type": "dropdown",
      "label": "Preferred time",
      "required": false,
      "width": "half",
      "options": [
        { "value": "morning", "label": "Morning" },
        { "value": "midday", "label": "Midday" },
        { "value": "afternoon", "label": "Afternoon" }
      ]
    },
    { "id": "sv-message", "type": "paragraph", "label": "Anything we should know?", "required": false }
  ],
  "notifications": [
    {
      "id": "sv-default",
      "name": "Default",
      "logic": "AND",
      "rules": [],
      "targetType": "role",
      "roleId": "salesperson",
      "scopeMode": "dynamic"
    }
  ]
}
